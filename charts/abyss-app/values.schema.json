{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "abyss-app Helm Values Schema",
  "type": "object",
  "required": ["app", "environment", "image"],
  "properties": {
    "app": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "environment": {
      "type": "string",
      "enum": ["prod", "preview"]
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "priorityClassName": {
      "type": "string"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "namespace": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "ingressLabel": {
          "type": "string"
        },
        "psa": {
          "type": "object",
          "properties": {
            "enforce": {
              "type": "string",
              "enum": ["privileged", "baseline", "restricted"]
            },
            "enforceVersion": {
              "type": "string",
              "minLength": 1
            },
            "audit": {
              "type": "string",
              "enum": ["privileged", "baseline", "restricted"]
            },
            "auditVersion": {
              "type": "string",
              "minLength": 1
            },
            "warn": {
              "type": "string",
              "enum": ["privileged", "baseline", "restricted"]
            },
            "warnVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": ["integer", "string"]
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "issuerName": {
              "type": "string"
            },
            "issuerKind": {
              "type": "string"
            },
            "dnsNames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "ingresses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "pathType": {
            "type": "string",
            "enum": ["Prefix", "Exact", "ImplementationSpecific"]
          },
          "serviceName": {
            "type": "string"
          },
          "servicePort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "operatorAccess": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceAccountName": {
          "type": "string"
        },
        "serviceAccountNamespace": {
          "type": "string"
        },
        "clusterRoleName": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "cnpg": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "instances": {
              "type": "integer",
              "minimum": 1
            },
            "imageName": {
              "type": "string"
            },
            "enableSuperuserAccess": {
              "type": "boolean"
            },
            "priorityClassName": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string"
            },
            "injectDatabaseUrl": {
              "type": "boolean"
            },
            "databaseUrlKey": {
              "type": "string"
            },
            "secretName": {
              "type": "string"
            },
            "prune": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "cronJobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "schedule"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "schedule": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "extraWorkloads": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "replicas": {
            "type": "integer",
            "minimum": 0
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "configMaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["apiVersion", "kind", "metadata"]
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"]
      }
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
